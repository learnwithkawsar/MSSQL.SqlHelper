<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MSSQL.SqlHelper</RootNamespace>
    <AssemblyName>MSSQL.SqlHelper</AssemblyName>

    <PackageId>MSSQL.SqlHelper</PackageId>
    <Version>2.0.0</Version>
    <Authors>Kawsar Ahmed</Authors>
    <Description>SqlHelper is a simple class to help with Microsoft SQL Server databases on .NET Framework: run stored procedures and T-SQL and get back a DataSet, DataTable, SqlDataReader, XmlReader, scalar value or row count.</Description>
    <Copyright>Copyright 2019-2026 Kawsar Ahmed</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sql;sqlserver;mssql;microsoft;database;data;ado.net;netframework</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/learnwithkawsar/MSSQL.SqlHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/learnwithkawsar/MSSQL.SqlHelper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>2.0.0: targets .NET Framework 4.6.2 and uses Microsoft.Data.SqlClient. See the README for upgrade notes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MSSQL.SqlHelper.Tests" />
  </ItemGroup>

</Project>
